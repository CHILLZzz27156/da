3)apriori

import pandas as pd
from efficient_apriori import apriori

data = pd.read_csv('3.csv', names=['name'], header=None)


trans = [x.split(',') for x in data['name']]


itemsets, rules = apriori(trans, min_support=0.25, min_confidence=0.5)


print("Frequent Itemsets:")
for size in itemsets:
    for itemset in itemsets[size]:
        print(itemset, "->", itemsets[size][itemset])


print("\nRules:")
for rule in rules:
    print(rule)












