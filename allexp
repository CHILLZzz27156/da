import numpy as np
import pandas as pd

data = pd.read_csv('1.csv')

a = np.array(data)[:, :-1]  
tgt = np.array(data)[:, -1] 

def train(a, tgt):

 
    for i, val in enumerate(tgt):
        if val == 'yes':
            sp_h = a[i].copy()
            break

    for i, val in enumerate(a):
        if tgt[i] == 'yes':
            for x in range(len(sp_h)):
                if val[x] != sp_h[x]:
                    sp_h[x] = '?'

    return sp_h

final_h = train(a, tgt)
print(final_h)







