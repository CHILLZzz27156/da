import pandas as pd
data=pd.read_csv('1.csv')
print(data)
a=np.array(data)[:,:-1]
print(a)
tgt=np.array(data)[:,-1]
print(tgt)

def train(c,t):
    for i,val in enumerate(t):
        if val=='yes':
            sp_h=c[i].copy()
            break
    for i,val in enumerate(c):
        if t[i]=='yes':
            for x in range(len(sp_h)):
                if val[x]!=sp_h[x]:
                    sp_h[x]='?'
                    return sp_h
final_h=train(a,tgt)
